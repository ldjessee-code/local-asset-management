{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ldjessee-code/local-asset-management/schemas/lam-place.v1.schema.json",
  "title": "lam-place/v1",
  "description": "Result of single-file lam stage FILE or lam place STAGED DEST. sha256 is the final dest sha after a successful place. trash_path is null when the Recycle Bin path is unknown.",
  "type": "object",
  "required": [
    "schema",
    "status",
    "dest",
    "staged",
    "sha256",
    "old_sha256",
    "backup_path",
    "trash_path",
    "size",
    "message"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "lam-place/v1" },
    "status": { "type": "string", "minLength": 1 },
    "dest": { "type": ["string", "null"] },
    "staged": { "type": ["string", "null"] },
    "sha256": { "type": ["string", "null"] },
    "old_sha256": { "type": ["string", "null"] },
    "backup_path": { "type": ["string", "null"] },
    "trash_path": { "type": ["string", "null"] },
    "size": { "type": ["integer", "null"], "minimum": 0 },
    "message": { "type": "string" }
  }
}
