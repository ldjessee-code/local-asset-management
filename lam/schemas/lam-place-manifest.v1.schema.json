{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ldjessee-code/local-asset-management/schemas/lam-place-manifest.v1.schema.json",
  "title": "lam-place-manifest/v1",
  "description": "Files lam place may copy from a staging out folder. Anything not listed is refused.",
  "type": "object",
  "required": ["schema", "job", "target", "entries"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "lam-place-manifest/v1" },
    "job": { "type": "string", "minLength": 1 },
    "target": { "type": "string", "minLength": 1 },
    "created": { "type": "string", "minLength": 1 },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "required": ["src", "dest", "sha256", "size", "role", "original"],
      "additionalProperties": false,
      "properties": {
        "src": { "type": "string", "minLength": 1 },
        "dest": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "size": { "type": "integer", "minimum": 0 },
        "role": { "enum": ["file", "stand-in", "original-zip"] },
        "original": { "type": ["string", "null"] }
      }
    }
  }
}
