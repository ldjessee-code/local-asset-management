{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ldjessee-code/local-asset-management/schemas/lam-oversize-register.v1.schema.json",
  "title": "lam-oversize-register/v1",
  "description": "One central register of oversize images. There is no per-image sidecar.",
  "type": "object",
  "required": ["schema", "entries"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "lam-oversize-register/v1" },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "original_path",
        "sha256",
        "bytes",
        "mb",
        "width",
        "height",
        "megapixels",
        "combined",
        "combined_evidence",
        "parts_found",
        "part_paths",
        "parts_area_pct",
        "proxy_path",
        "proxy_width",
        "proxy_height",
        "zip_path",
        "zip_verified",
        "original_recycled",
        "flag",
        "status",
        "error",
        "first_seen",
        "updated",
        "paths_seen"
      ],
      "properties": {
        "original_path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "bytes": { "type": "integer", "minimum": 0 },
        "mb": { "type": "number", "minimum": 0 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "megapixels": { "type": "number", "minimum": 0 },
        "combined": { "type": "boolean" },
        "combined_evidence": { "type": "string", "minLength": 1 },
        "parts_found": { "enum": ["yes", "partial", "no"] },
        "part_paths": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "parts_area_pct": { "type": "integer", "minimum": 0 },
        "proxy_path": { "type": ["string", "null"] },
        "proxy_width": { "type": ["integer", "null"] },
        "proxy_height": { "type": ["integer", "null"] },
        "zip_path": { "type": ["string", "null"] },
        "zip_verified": { "type": "boolean" },
        "original_recycled": { "type": "boolean" },
        "flag": { "const": "large, revisit for subdivision" },
        "status": { "enum": ["planned", "done", "error"] },
        "error": { "type": ["string", "null"] },
        "first_seen": { "type": "string", "minLength": 10 },
        "updated": { "type": "string", "minLength": 10 },
        "paths_seen": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
